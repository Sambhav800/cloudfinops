{
  "resource_changes": [
    {
      "address": "aws_instance.web",
      "type": "aws_instance",
      "change": {
        "actions": ["create"],
        "after": { "instance_type": "t3.medium" }
      }
    },
    {
      "address": "aws_ebs_volume.data",
      "type": "aws_ebs_volume",
      "change": {
        "actions": ["create"],
        "after": { "size": 100 }
      }
    },
    {
      "address": "aws_s3_bucket.legacy",
      "type": "aws_s3_bucket",
      "change": {
        "actions": ["delete"],
        "before": { "bucket": "old-data" }
      }
    },
    {
      "address": "google_compute_instance.app",
      "type": "gcp_compute_instance",
      "change": {
        "actions": ["create"],
        "after": { "machine_type": "e2-medium" }
      }
    }
  ]
}
