{
  "test_metadata": {
    "name": "CloudFinOps Enterprise Stress Test v1",
    "purpose": "Validate cost simulator pricing accuracy, finding triggers, and scanner resource type coverage across all three clouds",
    "expected_monthly_delta_range": [28000, 35000],
    "expected_findings": ["ec2-old-generation", "ebs-gp2-to-gp3", "public-ipv4-cost", "nat-gateway-baseline"],
    "expected_unestimated_count": 3,
    "covers": {
      "providers": ["aws", "azure", "gcp"],
      "actions": ["create", "update", "delete", "no-op"],
      "resource_families": ["compute", "storage", "network", "database", "serverless", "kubernetes", "other"],
      "regions": {
        "aws": ["us-east-1", "eu-west-1", "ap-southeast-1"],
        "azure": ["eastus", "westeurope", "centralindia"],
        "gcp": ["us-central1", "europe-west1", "asia-east1"]
      }
    }
  },
